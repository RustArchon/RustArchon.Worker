{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  // Username/Password deliberately absent - see RabbitMqOptions's remarks; they come from the flat
  // RABBITMQ_DEFAULT_USER/PASS keys below instead.
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/"
  },
  "Api": {
    "BaseUrl": "http://localhost:5130"
  },
  // Read directly by name - the exact same key RustArchon.Api and the Blazor web app also read. See
  // InternalApiOptions's remarks. RABBITMQ_DEFAULT_USER/PASS additionally match the RabbitMQ
  // container's own required names - see RabbitMqOptions's remarks.
  "RUSTARCHON_INTERNAL_API_KEY": "",
  "RABBITMQ_DEFAULT_USER": "guest",
  "RABBITMQ_DEFAULT_PASS": "guest",
  "Reconnect": {
    "ReconnectTimeout": null,
    "ErrorReconnectTimeout": "00:00:10"
  }
}
